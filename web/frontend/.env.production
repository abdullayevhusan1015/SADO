# Backend URL used for production builds (Vercel).
# Committed on purpose so deploys do not depend on a dashboard field being
# typed correctly. Vite bakes this in at build time, so changing it requires
# a rebuild/redeploy, not just a restart.
#
# NOTE: a VITE_API_URL set in the Vercel project settings OVERRIDES this file.
# Leave that dashboard variable unset so this value governs.
VITE_API_URL=https://sado-dle9.onrender.com
